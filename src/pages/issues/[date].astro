---
import Base from "../../layouts/Base.astro";
import IssueFront from "../../components/IssueFront.astro";
import { SITE_NAME } from "../../lib/site";
import { formatIssueLabel } from "../../lib/issues";
import { allPublished, eventsInWindow, groupByIssue, splitIssue } from "../../lib/issue-content";

export async function getStaticPaths() {
  const published = await allPublished();
  const groups = groupByIssue(published);
  return [...groups.entries()].map(([slug, { date, articles }]) => ({
    params: { date: slug },
    props: { date, articles, published },
  }));
}

const { date, articles, published } = Astro.props;
const { stories, arrests } = splitIssue(articles);
const events = eventsInWindow(published, date, 6);
const label = formatIssueLabel(date);
---

<Base title={`${label} — ${SITE_NAME}`} description={`Weekly issue for ${label}.`} issue={date}>
  <IssueFront issue={date} stories={stories} events={events} arrests={arrests} />
</Base>
