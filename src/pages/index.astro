---
import Base from "../layouts/Base.astro";
import IssueFront from "../components/IssueFront.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";
import { issueSlug } from "../lib/issues";
import { allPublished, groupByIssue, latestIssueDate, splitIssue } from "../lib/issue-content";

const published = await allPublished();
const latest = latestIssueDate(published);
const groups = groupByIssue(published);
const issueArticles = latest ? (groups.get(issueSlug(latest))?.articles ?? []) : [];
const { stories, events, arrests } = splitIssue(issueArticles);
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION}>
  {latest ? (
    <IssueFront issue={latest} stories={stories} events={events} arrests={arrests} />
  ) : (
    <p class="empty">No issues are filed yet.</p>
  )}
</Base>
