---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { DESKS, formatDateline, withBase } from "../lib/site";

const published = (await getCollection("articles"))
  .filter((article) => article.data.status === "published")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const stories = published.filter(
  (article) => article.data.desk !== "blotter" && article.data.desk !== "calendar",
);
const blotter = published.filter((article) => article.data.desk === "blotter");
const events = published.filter((article) => article.data.desk === "calendar");
---

<Base title="Stillwater Civic Briefing">
  <div class="front">
    <section>
      {stories.length === 0 ? (
        <p class="empty">No stories are filed.</p>
      ) : (
        <ul class="paper-list">
          {stories.map((article) => (
            <li>
              <p class="kicker">{DESKS[article.data.desk].label} · {article.data.city}</p>
              <h2><a href={withBase(`articles/${article.id}/`)}>{article.data.title}</a></h2>
              <p class="meta">{formatDateline(article.data.date)}</p>
            </li>
          ))}
        </ul>
      )}
    </section>
    <aside class="side">
      <section class="blotter">
        <p class="kicker">Blotter</p>
        {blotter.length === 0 ? (
          <p class="empty">No bookings.</p>
        ) : (
          <ul class="blotter-list">
            {blotter.slice(0, 8).map((article) => (
              <li>
                <a href={withBase(`articles/${article.id}/`)}>{article.data.title}</a>
                <p class="charge">{article.data.charge}</p>
              </li>
            ))}
          </ul>
        )}
        <p><a href={withBase("blotter/")}>All bookings</a></p>
      </section>
      <section>
        <p class="kicker">Events</p>
        {events.length === 0 ? (
          <p class="empty">No festivals or civic events are filed.</p>
        ) : (
          <ul class="event-list">
            {events.map((article) => (
              <li>
                <a href={withBase(`articles/${article.id}/`)}>{article.data.title}</a>
                <br />
                <span class="meta">{formatDateline(article.data.date)} · {article.data.city}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    </aside>
  </div>
</Base>
