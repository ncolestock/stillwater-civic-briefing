---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE_NAME, withBase } from "../lib/site";

const places = (await getCollection("articles"))
  .filter((article) => article.data.status === "published" && article.data.places?.length)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id))
  .flatMap((article) =>
    (article.data.places ?? []).map((place, index) => ({
      id: `${article.id}-${index}`,
      article: article.id,
      title: place.label,
      note: place.note ?? "",
      lat: place.lat,
      lng: place.lng,
    })),
  );
---

<Base title={`Land — ${SITE_NAME}`}>
  <header class="section-banner">
    <p class="kicker">Addresses named in the agendas</p>
    <h1>Land</h1>
  </header>
  <p class="section-note">
    The marks are the addresses in the public records. County parcel lines were not in a file this paper could read, so a mark is not a surveyed lot.
  </p>
  {places.length === 0 ? (
    <p class="empty">No addresses are filed.</p>
  ) : (
    <div class="land-layout">
      <div id="land-map"></div>
      <ul class="place-list">
        {places.map((place) => (
          <li data-id={place.id}>
            <a href={withBase(`articles/${place.article}/`)}>{place.title}</a>
            {place.note && <p>{place.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  )}
  {places.length > 0 && (
    <>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script is:inline define:vars={{ places }}>
        const style = document.createElement("script");
        style.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
        style.onload = () => {
          const map = L.map("land-map").setView([45.05, -92.85], 11);
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "&copy; OpenStreetMap",
          }).addTo(map);
          const marks = {};
          const idle = { color: "#1A1612", weight: 1, fillColor: "#7A1F2B", fillOpacity: 0.35, radius: 10 };
          const hot = { color: "#7A1F2B", weight: 2, fillColor: "#7A1F2B", fillOpacity: 0.75, radius: 16 };
          for (const place of places) {
            const mark = L.circleMarker([place.lat, place.lng], idle).addTo(map);
            mark.bindTooltip(place.title);
            marks[place.id] = mark;
            const row = document.querySelector(`[data-id="${CSS.escape(place.id)}"]`);
            const on = () => {
              mark.setStyle(hot);
              row.classList.add("on");
            };
            const off = () => {
              mark.setStyle(idle);
              row.classList.remove("on");
            };
            row.addEventListener("mouseenter", on);
            row.addEventListener("mouseleave", off);
            mark.on("mouseover", on);
            mark.on("mouseout", off);
            mark.on("click", () => {
              window.location.href = row.querySelector("a").href;
            });
          }
        };
        document.head.appendChild(style);
      </script>
    </>
  )}
</Base>
