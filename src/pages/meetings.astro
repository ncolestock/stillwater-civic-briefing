---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { chicagoToday, chooseMonth, collectMeetings, daysInMonth } from "../lib/calendar";
import { SITE_NAME, withBase } from "../lib/site";

const articles = await getCollection("articles");
const meetings = collectMeetings(articles);
const today = chicagoToday();
const shown = chooseMonth(meetings, today);
const monthLabel = new Date(Date.UTC(shown.year, shown.month - 1, 1)).toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const first = new Date(Date.UTC(shown.year, shown.month - 1, 1)).getUTCDay();
const count = daysInMonth(shown.year, shown.month);
const cells: Array<number | null> = [
  ...Array.from({ length: first }, () => null),
  ...Array.from({ length: count }, (_, i) => i + 1),
];
while (cells.length % 7) cells.push(null);

const inMonth = meetings.filter((item) => item.year === shown.year && item.month === shown.month);
const byDay: Record<number, typeof inMonth> = {};
for (const item of inMonth) {
  (byDay[item.day] ??= []).push(item);
}
const stories = [...new Map(inMonth.map((item) => [item.articleId, item])).values()];
const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
---

<Base title={`Meetings — ${SITE_NAME}`}>
  <header class="section-banner">
    <p class="kicker">{monthLabel}</p>
    <h1>Meetings</h1>
  </header>
  {stories.length > 0 ? (
    <p class="section-note">
      {stories.map((item, i) => (
        <>
          {i > 0 && " · "}
          <a href={withBase(`articles/${item.articleId}/`)}>{item.articleTitle}</a>
        </>
      ))}
    </p>
  ) : (
    <p class="section-note">No meetings are filed for {monthLabel}.</p>
  )}
  <div class="month" role="grid" aria-label={monthLabel}>
    {weekdays.map((day) => <div class="day head">{day}</div>)}
    {cells.map((day) => {
      const items = day == null ? [] : (byDay[day] ?? []);
      return (
        <div class:list={["day", { meet: items.length > 0 }]}>
          {day != null && <span class="num">{day}</span>}
          {items.map((item) => (
            <a class="meet-link" href={item.url}>
              {item.time && <strong>{item.time}</strong>} {item.what}
              {item.where && <span>{item.where}</span>}
            </a>
          ))}
        </div>
      );
    })}
  </div>
</Base>
