---
import { getCollection } from "astro:content";
import { articleAnchor, issueDateForArticle, issueSlug } from "../../lib/issues";
import { withBase } from "../../lib/site";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).filter(
    (article) => article.data.status === "published",
  );
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const issue = issueDateForArticle(article.data.date, article.data.issue ?? null);
const target = withBase(`issues/${issueSlug(issue)}/#${articleAnchor(article.id)}`);
return Astro.redirect(target, 301);
---
