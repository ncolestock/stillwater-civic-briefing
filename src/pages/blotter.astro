---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import ExpandablePiece from "../components/ExpandablePiece.astro";
import { SITE_NAME, withBase } from "../lib/site";

const blotter = (await getCollection("articles"))
  .filter((article) => article.data.status === "published" && article.data.desk === "blotter")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id));
---

<Base title={`Arrests — ${SITE_NAME}`}>
  <div class="section-banner">
    <p class="kicker">Washington County Jail</p>
    <h1>Arrests</h1>
  </div>
  <p class="section-note">
    Tap a name to read the booking in place. Each row has a share link.
    <a href={withBase("issues/")}>Past Monday issues</a> keep the week’s arrests together.
  </p>
  {blotter.length === 0 ? (
    <p class="empty">No bookings.</p>
  ) : (
    <div class="expand-stack">
      {blotter.map((article) => (
        <ExpandablePiece article={article} variant="arrest" />
      ))}
    </div>
  )}
  <script is:inline>
    (function () {
      function openFromHash() {
        var id = (location.hash || "").replace(/^#/, "");
        if (!id) return;
        var el = document.getElementById(id);
        if (!el || el.tagName !== "DETAILS") return;
        el.open = true;
        el.scrollIntoView({ block: "start", behavior: "smooth" });
      }
      openFromHash();
      window.addEventListener("hashchange", openFromHash);
      document.addEventListener("click", function (e) {
        var t = e.target;
        if (!(t instanceof Element)) return;
        var btn = t.closest("[data-share-path]");
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        var path = btn.getAttribute("data-share-path");
        if (!path) return;
        var url = new URL(path, location.origin).href;
        function flash() {
          btn.classList.add("is-copied");
          btn.setAttribute("title", "Link copied");
          setTimeout(function () {
            btn.classList.remove("is-copied");
            btn.setAttribute("title", "Copy share link");
          }, 1600);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(flash).catch(function () { prompt("Copy share link", url); });
        } else {
          prompt("Copy share link", url);
        }
      });
      document.addEventListener("toggle", function (e) {
        var el = e.target;
        if (!(el instanceof HTMLDetailsElement) || !el.id || !el.classList.contains("piece")) return;
        if (el.open) history.replaceState(null, "", "#" + el.id);
        else if (location.hash === "#" + el.id) history.replaceState(null, "", location.pathname + location.search);
      }, true);
    })();
  </script>
</Base>
