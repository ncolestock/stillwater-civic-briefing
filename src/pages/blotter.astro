---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE_NAME, formatDateline, withBase } from "../lib/site";

const bookings = (await getCollection("articles"))
  .filter((article) => article.data.status === "published" && article.data.desk === "blotter")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title));
---

<Base title={`Blotter — ${SITE_NAME}`}>
  <header class="section-banner">
    <p class="kicker">Washington County Jail</p>
    <h1>Blotter</h1>
  </header>
  <ul class="blotter-list">
    {bookings.map((booking) => (
      <li>
        <a href={withBase(`articles/${booking.id}/`)}>{booking.data.title}</a>
        <p class="charge">{booking.data.charge}</p>
        <p class="meta">{formatDateline(booking.data.date)}</p>
      </li>
    ))}
  </ul>
</Base>
