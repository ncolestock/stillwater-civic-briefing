---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDateline, withBase } from "../lib/site";

const bookings = (await getCollection("articles"))
  .filter((article) => article.data.status === "published" && article.data.desk === "blotter")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title));
---

<Base title="Blotter — Stillwater Civic Briefing">
  <header class="section-banner">
    <p class="kicker">Washington County Jail</p>
    <h1>Blotter</h1>
  </header>
  <div class="blotter blotter-full">
    <table>
      <thead>
        <tr><th>Booked</th><th>Name</th><th>Charge on the report</th></tr>
      </thead>
      <tbody>
        {bookings.map((booking) => (
          <tr>
            <td class="when">{formatDateline(booking.data.date)}</td>
            <td><a href={withBase(`articles/${booking.id}/`)}>{booking.data.title}</a></td>
            <td>{booking.data.charge}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
