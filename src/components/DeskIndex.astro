---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { DESKS, SITE_NAME, formatDateline, withBase, type DeskId } from "../lib/site";

interface Props {
  desk: DeskId;
}
const { desk } = Astro.props;
const label = DESKS[desk].label;
const articles = (await getCollection("articles"))
  .filter((article) => article.data.status === "published" && article.data.desk === desk)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={`${label} — ${SITE_NAME}`}>
  <header class="section-banner">
    <h1>{label}</h1>
  </header>
  {articles.length === 0 ? (
    <p class="empty">Nothing is filed on this desk.</p>
  ) : (
    <ul class="index-list">
      {articles.map((article) => (
        <li>
          <p class="meta">{formatDateline(article.data.date)} · {article.data.city}</p>
          <h2><a href={withBase(`articles/${article.id}/`)}>{article.data.title}</a></h2>
          <p>{article.data.bodies.join(", ")}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
