---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { DESKS, formatDateline, formatShortDateline, plainFirstParagraph, withBase } from "../lib/site";
import { articleAnchor, issueDateForArticle, issueSlug } from "../lib/issues";

interface Props {
  article: CollectionEntry<"articles">;
  variant?: "story" | "event" | "arrest";
  lead?: boolean;
}

const { article, variant = "story", lead = false } = Astro.props;
const { Content } = await render(article);
const deck = plainFirstParagraph(article.body, variant === "arrest" ? 220 : 320);
const anchor = articleAnchor(article.id);
const issue = issueDateForArticle(article.data.date, article.data.issue ?? null);
const sharePath = withBase(`issues/${issueSlug(issue)}/#${anchor}`);
const countyish = /washington\s+county/i.test(article.data.city);
const kicker =
  variant === "arrest"
    ? (countyish ? null : article.data.city)
    : `${DESKS[article.data.desk].label} · ${article.data.city}`;
const shortDate = formatShortDateline(article.data.date);
const longDate = formatDateline(article.data.date);
---

<details class:list={["piece", `piece-${variant}`, { "piece-lead": lead }]} id={anchor}>
  <summary class="piece-summary">
    {variant === "arrest" ? (
      <div class="arrest-card">
        <div class="arrest-top">
          <h2 class="piece-hed">{article.data.title}</h2>
          <button
            type="button"
            class="share-icon"
            data-share-path={sharePath}
            aria-label="Copy share link"
            title="Copy share link"
          >
            <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M11 17H7a5 5 0 0 1 0-10h4v2H7a3 3 0 0 0 0 6h4v2zm2-10h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 0 0 0-6h-4V7zm-5 4h8v2H8v-2z"
              />
            </svg>
          </button>
        </div>
        <p class="arrest-meta">
          <span class="arrest-date">{shortDate}</span>
          {article.data.charge && (
            <>
              <span class="arrest-sep" aria-hidden="true">·</span>
              <span class="charge">{article.data.charge}</span>
            </>
          )}
        </p>
      </div>
    ) : (
      <>
        <div class="story-top">
          <div class="story-id">
            {kicker && <p class="kicker">{kicker}</p>}
            <h2 class="piece-hed">{article.data.title}</h2>
          </div>
          <button
            type="button"
            class="share-icon"
            data-share-path={sharePath}
            aria-label="Copy share link"
            title="Copy share link"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M11 17H7a5 5 0 0 1 0-10h4v2H7a3 3 0 0 0 0 6h4v2zm2-10h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 0 0 0-6h-4V7zm-5 4h8v2H8v-2z"
              />
            </svg>
          </button>
        </div>
        {variant === "event" && (
          <p class="meta piece-meta">
            <span class="piece-date">{longDate} · {article.data.city}</span>
          </p>
        )}
        {variant !== "arrest" && deck && <p class="deck">{deck}</p>}
      </>
    )}
  </summary>
  <div class="piece-body">
    {article.data.correction && <p class="correction">{article.data.correction}</p>}
    <div class="prose">
      <Content />
    </div>
    <aside class="sources-block" aria-label="Sources">
      <p class="sources-label">Sources</p>
      <ul class="sources">
        {article.data.sources.map((source) => (
          <li><a href={source.url}>{source.label}</a></li>
        ))}
      </ul>
    </aside>
  </div>
</details>
